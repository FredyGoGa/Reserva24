generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id          String      @id
  name        String
  price       Int
  oldPrice    Int?
  category    String
  brand       String
  size        String
  image       String?
  description String?
  accent      String
  featured    Boolean     @default(false)
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([active])
  @@index([category])
}

model Order {
  id           String      @id
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  customerName String
  document     String
  phone        String
  email        String
  address      String
  notes        String?
  total        Int
  items        OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  qty       Int
  unitPrice Int
  subtotal  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}